generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user") // Roles: user, admin
  businesses Business[]
}

model Business {
  id            String   @id @default(cuid())
  name          String
  industry      String?
  whatsappNumber String
  description   String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
}